# 依赖
node_modules/
pnpm-store/

# Rust / Tauri 构建产物
src-tauri/target/
src-tauri/gen/schemas/

# 前端构建产物
dist/

# Xcode / iOS 构建产物
src-tauri/gen/apple/Externals/
src-tauri/gen/apple/build/
# assets 由 deploy-ios.sh 从 dist 同步而来，属构建产物；目录本身需存在（Xcode Resources 引用）
src-tauri/gen/apple/assets/*
!src-tauri/gen/apple/assets/.gitkeep
.deploy-logs/
*.xcuserdatad/
*.xcuserdata/
DerivedData/

# 系统文件
.DS_Store
Thumbs.db

# 编辑器
.idea/
.vscode/
*.swp
*.swo

# 环境与日志
.env
.env.*
*.log

# cargo registry 解包残留（源码手改补丁目录内不需要）
src-tauri/patches/*/.cargo-ok
src-tauri/patches/*/.cargo_vcs_info.json
